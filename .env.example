# ==========================================
# VideoMind-AI Environment Configuration
# Copy this file to '.env' and fill in your values
# ==========================================

# Server Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# AI Models Configuration
WHISPER_MODEL_SIZE=base          # Options: tiny, base, small, medium (base/small recommended for 6GB VRAM)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
DEVICE=cuda                      # Options: cuda (NVIDIA GPU) or cpu

# Vector Database (Local Storage)
CHROMA_PERSIST_DIR=./data/chroma_db
AUDIO_CACHE_DIR=./data/audio_cache
KEYFRAME_CACHE_DIR=./data/keyframes

# Optional LLM API Key (For Grounded Synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
